# Copy to `.env.local` and fill in.

# GitHub personal access token (classic or fine-grained, read-only public repo).
# Lifts the API rate limit from 60/hr (anonymous) to 5,000/hr, which is required
# for the live developer-health metrics to populate. No scopes/permissions are
# needed beyond public read.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Contract deployment (only needed to run `npm run deploy:sepolia`) ---
# The contracts are ALREADY deployed to Sepolia (addresses live in
# src/lib/contracts/verifier.ts); you only need these to redeploy.
#
# Deployer wallet. Use a THROWAWAY wallet funded with Sepolia faucet ETH only —
# never a real/mainnet key. `.env.local` is gitignored; never commit a key.
PRIVATE_KEY=
PUBLIC_KEY=
# Optional — defaults to a public Sepolia RPC if unset.
SEPOLIA_RPC_URL=

# --- Wallet connection (RainbowKit / WalletConnect) ---
# Free WalletConnect Cloud project ID, needed for the "Connect Wallet" button's
# WalletConnect/mobile-wallet flow (injected wallets like MetaMask work without
# it, but RainbowKit still requires a value to initialize). Get one at
# https://cloud.reown.com (formerly WalletConnect Cloud) — sign up, create a
# project, copy its Project ID. Public by design (NEXT_PUBLIC_*), safe to expose
# in the browser bundle.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Historical data (Neon Postgres + Drizzle) ---
# Powers daily snapshots of ecosystem metrics for historical trend charts.
# Provision a free Neon Postgres database either via the Vercel Marketplace
# (Vercel dashboard -> Storage -> Marketplace Database Providers -> Neon) so
# DATABASE_URL is auto-added to your Vercel project's env vars, or directly
# at https://neon.tech (free tier: 0.5 GB storage, plenty for this). Either
# way, copy the connection string here too for local dev.
DATABASE_URL=

# Secret for the daily snapshot cron (src/app/api/cron/snapshot/route.ts,
# scheduled in vercel.json). Vercel sends this back as
# `Authorization: Bearer $CRON_SECRET` when it invokes the route — generate a
# random value (e.g. `openssl rand -hex 24`), set it here for local testing,
# and add the SAME value to the Vercel project's env vars (Production) so the
# real cron invocation is authorized.
CRON_SECRET=

